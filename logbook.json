 "rules": {
  "read": "find bots[you]; that is your order",
  "write": "on change: update your bots[] row + append 1 log entry. No other reports.",
  "loop": [
   "STARTED",
   "VERIFIED",
   "DONE",
   "NEXT"
  ],
  "blocked": "set status BLOCKED + add blockers[] + take next immediately. Stays BLOCKED until reviewed by COL Whiz, Pip, or their delegate.",
  "idle": "never; no job = first jobs[] with status OPEN and owner null, else ask CMD",
  "check_every_min": 20,
  "check": [
   "doing == bots[you].job?",
   "blocked or done -> take next",
   "need chain? -> log type ASK to COL Whiz"
  ],
  "chain": [
   "bot",
   "COL Whiz",
   "Pip",
   "Leon"
  ],
  "deadline": "every job has due (UTC). Miss due = COL Whiz reassigns. Reason logged, not debated.",
  "library": "library{} = all open work. Idle bot takes first item with owner null, sets owner=self, status STARTED, due=now+24h."
 },
